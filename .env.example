# Local dev works with no env at all (SQLite file ./dev.db, dev-only auth secret).
# Production (Vercel):
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
AUTH_SECRET=             # long random string, e.g. `openssl rand -base64 32`
ADMIN_PASSCODE=          # required to sign in as operator/admin in production (mock auth)
ADMIN_EMAIL=             # email for the seeded admin account (default admin@example.com)
ORS_API_KEY=             # optional: free key from openrouteservice.org; enables "snap to streets" in the route editor
